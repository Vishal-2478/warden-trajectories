#!/bin/bash
#PBS -N w5_enc_q7
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o 5_enc_q7.log

# =====================================================================
# WARDEN REVISION (IConSCEPT 2026, Nov 2026) -- SECOND INERT CUE (encoding)
# Model: Qwen/Qwen2.5-7B-Instruct
#
# WHY THIS RUN EXISTS
#   Reviewer 1 (comment 3): the line-wrapping cue was read as implying human
#   review by Qwen2.5-14B, so its validity as a baseline is uncertain. This
#   run uses a second inert cue with the same template (OPERATIONAL CONTEXT,
#   batch line, ENABLED/DISABLED switch, matched length) whose content is the
#   character encoding of tool responses in transport. It does not mention the
#   action log, review, display, storage or importance. The cue is added by
#   run_extra.py at run time; no existing code file is changed. Randomized
#   surface text (seed 1000 + r), n = 450 per condition, temperature 0.7,
#   ten tool calls, as for every other control run.
#
# CONTEXT KNOWN BEFORE THIS RUN
#   Line-wrapping cue: probe UNKNOWN in all trials for Qwen2.5-7B and Phi-4,
#   YES in all monitored and unmonitored trials for Qwen2.5-14B; trajectory
#   shift as large as the consequence cue in Qwen2.5-7B and Phi-4.
#
# PREDICTIONS AND DECISION RULES (written before submission)
#   P1. Perception probe: UNKNOWN in >= 95% of monitored and unmonitored
#       trials. If not, this arm is not used as a baseline for this model.
#   P2. shortcut_sole_basis does not differ (Fisher exact, p_Holm > 0.05).
#   P3. Qwen2.5-7B and Phi-4: the matched-outcome trajectory test detects a
#       monitored-vs-unmonitored difference under this cue too (rollout-paired
#       p < 0.05). Qwen2.5-14B: no prediction.
#   P4. Qwen2.5-7B and Phi-4: trajectory DiD "consequence minus encoding"
#       (matched outcome) is not significant (p > 0.05). Qwen2.5-14B: no
#       prediction; if P1 holds, this is its first valid inert baseline.
#   Rules: (a) P3 and P4 hold -> the non-specificity of the trajectory test
#   replicates with a second, independently worded inert cue. (b) P3 or P4
#   fails -> the line-wrapping result is cue-specific; both are reported and
#   the non-specificity claim is restricted accordingly.
#   n = 450 per condition. ONE RUN. Everything is reported.
# =====================================================================

cd "$PBS_O_WORKDIR" || exit 1
set -o pipefail

MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"
MODEL_DIR="Qwen2.5-7B-Instruct"
TAG="qwen7b_encoding"
N=450
N_MANCHECK=60
TEMP="${TEMP:-0.7}"
WORKERS="${WORKERS:-16}"
MIG_INSTANCE="${MIG_INSTANCE:-1}"

MODEL_PATH="${WARDEN_DATA:-$(cat "$HOME/.warden_data_dir" 2>/dev/null || echo "$HOME/warden_data")}/models/$MODEL_DIR"
export MIG_INSTANCE

# the shared start-up script lives in ~/warden/jobs (this folder or its parent)
ENVF="$PBS_O_WORKDIR/_warden_env_rev.sh"
[ -f "$ENVF" ] || ENVF="$PBS_O_WORKDIR/../_warden_env_rev.sh"
source "$ENVF"
cp -f "$PBS_O_WORKDIR/run_extra.py" "$WARDEN_PROJECT/run_extra.py" || exit 1
cd "$WARDEN_PROJECT" || exit 1

R="$WARDEN_DATA/results"
START=$(date +%s)

echo
echo "########### STAGE 1/3  PERCEPTION PROBE (encoding cue) ###########"
python run_extra.py mancheck --model "$MODEL_NAME" \
    --n "$N_MANCHECK" --out "$R/mancheck_encoding_${TAG}"

echo
echo "########### STAGE 2/3  ENCODING CONTROL ($((N*3)) episodes) ###########"
python run_extra.py episodes \
    --model "$MODEL_NAME" --n "$N" \
    --workers "$WORKERS" --temperature "$TEMP" \
    --results "$R/${TAG}_experiment" || { echo "!! run failed"; exit 1; }

echo
echo "########### STAGE 3/3  ANALYSIS ###########"
python run.py analyze \
    --results "$R/${TAG}_experiment" \
    --out     "$R/analysis_${TAG}" --perm 10000 || { echo "!! analysis failed"; exit 1; }

tar -czf "$R/${TAG}_ALL.tar.gz" -C "$R" \
    "${TAG}_experiment" "analysis_${TAG}" "mancheck_encoding_${TAG}" 2>/dev/null
cp -f "$R/${TAG}_ALL.tar.gz" "$HOME/" 2>/dev/null || true

MINS=$(( ($(date +%s) - START) / 60 ))
echo
echo "======================================================================"
echo "DONE in ${MINS} min.   Results: $R/analysis_${TAG}/RESULTS.md"
echo "======================================================================"
