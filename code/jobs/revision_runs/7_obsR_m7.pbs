#!/bin/bash
#PBS -N w7_obsR_m7
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o 7_obsR_m7.log

# =====================================================================
# WARDEN REVISION (IConSCEPT 2026, Nov 2026) -- OBSERVATION CUE, RANDOMIZED
# Model: mistralai/Mistral-7B-Instruct-v0.3
#
# WHY THIS RUN EXISTS
#   Reviewer 1 (comment 2) and Reviewer 2 (comment 2): the observation runs
#   were produced by the calibrate stage WITHOUT --randomize, so every episode
#   showed the same surface text, unlike every other arm. This run repeats the
#   observation arm with --randomize (seed 1000 + r per rollout, identical text
#   across conditions), protocol otherwise unchanged (same cue text, n = 450
#   per condition, temperature 0.7, ten tool calls).
#
# CONTEXT KNOWN BEFORE THIS RUN
#   Fixed-text observation arm: no difference in shortcut_sole_basis in any of
#   the four models (largest gap 1.3 points); manipulation check 100%.
#
# PREDICTIONS AND DECISION RULES (written before submission)
#   P1. shortcut_sole_basis does not differ between monitored and
#       unmonitored (Fisher exact, p_Holm > 0.05).
#   P2. verification_complete does not differ (p_Holm > 0.05).
#   Trajectory test (matched outcome, rollout-paired, 10,000 permutations)
#   and the trajectory DiD "observation minus inert": no prediction, reported
#   in full.
#   Rules: (a) P1 holds in all four models -> the observation null is
#   reported as replicated under randomization; the fixed-text runs become a
#   robustness note. (b) P1 fails in any model -> the randomized result
#   replaces the fixed-text result for that model, and the abstract and
#   conclusion are revised accordingly.
#   n = 450 per condition. ONE RUN. Everything is reported.
# =====================================================================

cd "$PBS_O_WORKDIR" || exit 1
set -o pipefail

MODEL_NAME="mistralai/Mistral-7B-Instruct-v0.3"
MODEL_DIR="Mistral-7B-Instruct-v0.3"
TAG="mistral7b_obsR"
N=450
TEMP="${TEMP:-0.7}"
WORKERS="${WORKERS:-16}"
MIG_INSTANCE="${MIG_INSTANCE:-1}"

MODEL_PATH="${WARDEN_DATA:-$(cat "$HOME/.warden_data_dir" 2>/dev/null || echo "$HOME/warden_data")}/models/$MODEL_DIR"
export MIG_INSTANCE

# the shared start-up script lives in ~/warden/jobs (this folder or its parent)
ENVF="$PBS_O_WORKDIR/_warden_env_rev.sh"
[ -f "$ENVF" ] || ENVF="$PBS_O_WORKDIR/../_warden_env_rev.sh"
source "$ENVF"
cd "$WARDEN_PROJECT" || exit 1

R="$WARDEN_DATA/results"
START=$(date +%s)

echo
echo "########### STAGE 1/2  OBSERVATION CUE, RANDOMIZED ($((N*3)) episodes) ###########"
python run.py calibrate \
    --model "$MODEL_NAME" --n "$N" --randomize \
    --workers "$WORKERS" --temperature "$TEMP" \
    --results "$R/${TAG}_experiment" || { echo "!! run failed"; exit 1; }

echo
echo "########### STAGE 2/2  ANALYSIS ###########"
python run.py analyze \
    --results "$R/${TAG}_experiment" \
    --out     "$R/analysis_${TAG}" --perm 10000 || { echo "!! analysis failed"; exit 1; }

tar -czf "$R/${TAG}_ALL.tar.gz" -C "$R" "${TAG}_experiment" "analysis_${TAG}" 2>/dev/null
cp -f "$R/${TAG}_ALL.tar.gz" "$HOME/" 2>/dev/null || true

MINS=$(( ($(date +%s) - START) / 60 ))
echo
echo "======================================================================"
echo "DONE in ${MINS} min.   Results: $R/analysis_${TAG}/RESULTS.md"
echo "======================================================================"
